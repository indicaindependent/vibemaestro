# ══════════════════════════════════════════════════════════════════════════
#  VibeMaestro — environment contract
#  Copy to .dev.vars for local dev; set real values as Wrangler/Fly secrets in prod.
#  NOTHING real is committed. Every value below is a placeholder.
# ══════════════════════════════════════════════════════════════════════════

# ── Discord OAuth (the auth-gate) ──────────────────────────────────────────
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_bot_token            # reads guild-member roles for standing checks
OWNER_DISCORD_ID=your_discord_user_id       # this account is always approved / admin
SESSION_SIGNING_KEY=generate_a_random_32_byte_hex
BOT_SERVICE_KEY=shared_secret_service_mint  # guards /service/mint-session

# ── AI Gateway (the model gateway) ─────────────────────────────────────────
CF_ACCOUNT_ID=your_cloudflare_account_id
AIG_SLUG=your-gateway-slug                  # your Cloudflare AI Gateway slug
DEEPSEEK_API_KEY=                           # optional — paid DeepSeek default
VM_ANTHROPIC_KEY=                           # optional — platform Claude (users can BYO)
PAID_DAILY_CAP_USD=3.0                       # per-user in-worker soft spend cap

# ── Compute plane (the OpenCode bridge) ────────────────────────────────────
OPENCODE_SERVER_PASSWORD=generate_a_strong_password   # gates the private OpenCode server
BRIDGE_SHARED_SECRET=shared_secret_app_to_bridge      # app-worker <-> compute bridge
OPENCODE_URL=http://127.0.0.1:4096
PORT=8080

# ── Cross-service URLs (point these at YOUR deployed workers) ──────────────
GATE_URL=https://gate.example.com
APP_URL=https://app.example.com
DATA_URL=https://data.example.com
PUBLISH_URL=https://publish.example.com
REDIRECT_URI=https://gate.example.com/callback
