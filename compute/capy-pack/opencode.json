{
  "$schema": "https://opencode.ai/config.json",
  "model": "vibemaestro/capy-free",
  "provider": {
    "your-gateway-slug": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://gw.example.com/v1",
        "apiKey": "{env:VM_SESSION}"
      },
      "models": {
        "capy-free": {
          "name": "Capy (free \u00b7 CF Workers AI)"
        }
      }
    }
  },
  "agent": {
    "capy": {
      "description": "The resident free-tier super-agent of VibeMaestro. Warm, calm, capybara-chill, quietly elite. Ships working code fast.",
      "mode": "primary",
      "prompt": "{file:./agents/capy.md}",
      "temperature": 0.4,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "ls *": "allow",
          "cat *": "allow",
          "grep *": "allow",
          "git *": "allow"
        },
        "webfetch": "allow"
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "git *": "allow"
    },
    "webfetch": "allow"
  },
  "instructions": [
    "AGENTS.md"
  ],
  "autoupdate": false
}